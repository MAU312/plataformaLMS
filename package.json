{
  "name": "lms-cenat",
  "version": "1.0.0",
  "description": "Learning Management System for CeNAT",
  "scripts": {
    "start": "node src/app.js",
    "dev": "concurrently -k \"npm:watch:css\" \"npm:dev:server\"",
    "dev:server": "nodemon src/app.js",
    "build:css": "tailwindcss -i ./src/public/css/tailwind-input.css -o ./src/public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/public/css/tailwind-input.css -o ./src/public/css/tailwind.css --watch",
    "predev": "npm run build:css",
    "prestart": "npm run build:css",
    "test": "node --test"
  },
  "type": "module",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.1",
    "file-type": "^22.0.1",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.16.1",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.0.2",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "mysql2": "$mysql2"
  }
}
