# Base de datos MySQL
DB_HOST=localhost
DB_USER=tu_usuario
DB_PASS=tu_password
DB_NAME=lms_cenat

#Servidor
PORT=3000
NODE_ENV=development

# Sesión: generar con `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# NUNCA usar un valor de ejemplo/placeholder en producción.
SESSION_SECRET=

# Correo para recuperación de contraseña (Gmail).
# EMAIL_USER: la cuenta de Gmail que envía el correo.
# EMAIL_APP_PASSWORD: NO es la contraseña normal de la cuenta. Se genera en
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos
# activada en la cuenta de Google).
EMAIL_USER=
EMAIL_APP_PASSWORD=

# URL pública de la app, usada para armar el enlace de recuperación de
# contraseña dentro del correo (ej. https://lms.cenat.ac.cr).
APP_URL=http://localhost:3000

# Solo si el servidor corre detrás de un reverse proxy (Nginx, Apache, un
# balanceador). Sin esto detrás de un proxy real, el límite de intentos de
# login/registro por IP puede fallar; activarlo sin un proxy real permite
# a cualquier cliente falsificar su IP y saltarse ese límite.
TRUST_PROXY=

# Carpeta donde se guardan los archivos subidos (videos, imágenes, tareas,
# avatares, miniaturas). Opcional — por defecto es uploads/ en la raíz del
# proyecto. Cambiarla solo si el despliegue guarda los archivos en otro
# disco o en una unidad de red montada aparte del código.
UPLOADS_DIR=
